---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
{% include section-documents.html collection="paper_reviews" -%}
<feed xmlns="http://www.w3.org/2005/Atom">
  <id>{{ '/' | absolute_url | xml_escape }}</id>
  <title>{{ site.title | xml_escape }}</title>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <link rel="self" href="{{ '/feed.xml' | absolute_url | xml_escape }}" />
  <link href="{{ '/' | absolute_url | xml_escape }}" />
  <author><name>{{ site.author.name | xml_escape }}</name></author>
  {% for review in section_documents limit: 10 %}
  <entry>
    <id>{{ review.url | absolute_url | xml_escape }}</id>
    <title>{{ review.title | xml_escape }}</title>
    <link href="{{ review.url | absolute_url | xml_escape }}" />
    <published>{{ review.date | date_to_xmlschema }}</published>
    <updated>{{ review.last_modified_at | default: review.date | date_to_xmlschema }}</updated>
    <content type="html" xml:base="{{ review.url | absolute_url | xml_escape }}">{{ review.content | xml_escape }}</content>
  </entry>
  {% endfor %}
</feed>
