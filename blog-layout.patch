diff --git a/_layouts/default.html b/_layouts/default.html
new file mode 100644
index 0000000..f392bb4
--- /dev/null
+++ b/_layouts/default.html
@@ -0,0 +1,40 @@
+<!doctype html>
+<html lang="{{ site.lang | default: 'ko' | escape }}">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  {% seo %}
+  <script src="{{ '/assets/js/theme.js' | relative_url }}"></script>
+  <link rel="stylesheet" href="{{ '/assets/css/style.css' | relative_url }}">
+</head>
+<body>
+  <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
+  <header class="site-header">
+    <div class="site-header-inner">
+      <a class="site-name" href="{{ '/' | relative_url }}">{{ site.title | escape }}<span aria-hidden="true">.</span></a>
+
+      {% assign current_section = page.url %}
+      {% if page.layout == 'post' and page.categories contains 'paper-review' %}
+        {% assign current_section = '/paper-reviews/' %}
+      {% endif %}
+      <nav class="site-nav" aria-label="주 메뉴">
+        {% for item in site.navigation %}
+        <a href="{{ item.url | relative_url }}"{% if current_section == item.url %} aria-current="{% if page.url == item.url %}page{% else %}location{% endif %}"{% endif %}>{{ item.title | escape }}</a>
+        {% endfor %}
+      </nav>
+
+      <button class="theme-toggle" type="button" aria-pressed="false" hidden>다크 모드</button>
+    </div>
+  </header>
+
+  <main id="main-content" class="site-content">
+    {{ content }}
+  </main>
+
+  <footer class="site-footer">
+    <span>© {{ 'now' | date: '%Y' }} {{ site.title | escape }}</span>
+    <a href="https://github.com/{{ site.github_username }}">GitHub ↗</a>
+    <a href="mailto:{{ site.email }}">이메일</a>
+  </footer>
+</body>
+</html>
diff --git a/_layouts/post.html b/_layouts/post.html
new file mode 100644
index 0000000..45ca422
--- /dev/null
+++ b/_layouts/post.html
@@ -0,0 +1,18 @@
+---
+layout: default
+---
+<article>
+  <header class="post-intro">
+    {% if page.categories contains 'paper-review' %}
+    <a href="{{ '/paper-reviews/' | relative_url }}">← 논문 리뷰</a>
+    {% else %}
+    <a href="{{ '/' | relative_url }}">← 홈</a>
+    {% endif %}
+    <h1>{{ page.title | escape }}</h1>
+    <time datetime="{{ page.date | date_to_xmlschema }}">{{ page.date | date: site.date_format }}</time>
+  </header>
+
+  <div class="post-body">
+    {{ content }}
+  </div>
+</article>
diff --git a/assets/css/style.css b/assets/css/style.css
new file mode 100644
index 0000000..598fac7
--- /dev/null
+++ b/assets/css/style.css
@@ -0,0 +1,407 @@
+:root {
+  color-scheme: light;
+  --canvas: #f8f9fc;
+  --surface: #fff;
+  --text: #162237;
+  --muted: #4e5a70;
+  --line: #dce2ed;
+  --accent: #284ca9;
+  --accent-surface: #eef2fd;
+  --page-width: 900px;
+}
+
+:root[data-theme="dark"] {
+  color-scheme: dark;
+  --canvas: #101623;
+  --surface: #171f30;
+  --text: #e8edf9;
+  --muted: #aebacf;
+  --line: #344158;
+  --accent: #aec2ff;
+  --accent-surface: #222f4a;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+body {
+  min-height: 100vh;
+  display: flex;
+  flex-direction: column;
+  margin: 0;
+  background: var(--canvas);
+  color: var(--text);
+  font: 1rem/1.7 "Inter", "Noto Sans KR", "Noto Sans CJK KR", "Apple SD Gothic Neo", "Malgun Gothic", system-ui, sans-serif;
+  overflow-wrap: anywhere;
+  word-break: keep-all;
+}
+
+h1, h2, h3, p {
+  margin: 0;
+}
+
+h1, h2, h3 {
+  line-height: 1.3;
+  letter-spacing: -0.035em;
+}
+
+a {
+  color: var(--accent);
+  text-underline-offset: 0.2em;
+}
+
+:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 4px;
+}
+
+.skip-link {
+  position: fixed;
+  z-index: 1;
+  top: 1rem;
+  left: 1rem;
+  transform: translateY(-200%);
+  padding: 0.5rem 1rem;
+  background: var(--surface);
+}
+
+.skip-link:focus {
+  transform: none;
+}
+
+.site-header {
+  border-bottom: 1px solid var(--line);
+  background: var(--surface);
+}
+
+.site-header-inner,
+.site-content,
+.site-footer {
+  width: min(var(--page-width), calc(100% - 3rem));
+  margin-inline: auto;
+}
+
+.site-header-inner {
+  display: grid;
+  grid-template-columns: 1fr auto 1fr;
+  align-items: center;
+  gap: 0.75rem 1.5rem;
+  min-height: 70px;
+  padding-block: 0.65rem;
+}
+
+.site-name {
+  justify-self: start;
+  color: var(--text);
+  font-size: 1.3rem;
+  font-weight: 750;
+  letter-spacing: -0.05em;
+  text-decoration: none;
+}
+
+.site-name span {
+  color: var(--accent);
+}
+
+.site-nav {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.25rem;
+}
+
+.site-nav a,
+.theme-toggle {
+  padding: 0.45rem 0.75rem;
+  border-radius: 0.5rem;
+  color: var(--muted);
+  font: inherit;
+  font-size: 0.875rem;
+  font-weight: 650;
+  text-decoration: none;
+}
+
+.site-nav a:hover,
+.site-nav a[aria-current],
+.theme-toggle:hover,
+.theme-toggle[aria-pressed="true"] {
+  background: var(--accent-surface);
+  color: var(--accent);
+}
+
+.theme-toggle {
+  justify-self: end;
+  border: 1px solid var(--line);
+  background: var(--surface);
+  cursor: pointer;
+}
+
+.site-content {
+  flex: 1;
+  padding-block: clamp(2.75rem, 7vw, 5.25rem) 4.5rem;
+}
+
+.site-footer {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem 1.25rem;
+  padding-block: 1.25rem;
+  border-top: 1px solid var(--line);
+  color: var(--muted);
+  font-size: 0.85rem;
+}
+
+.site-footer span {
+  margin-right: auto;
+}
+
+.page-intro,
+.post-intro {
+  margin-bottom: 2rem;
+}
+
+.eyebrow {
+  margin-bottom: 0.85rem;
+  color: var(--accent);
+  font-size: 0.875rem;
+  font-weight: 750;
+}
+
+.home-hero {
+  margin-bottom: 2.75rem;
+}
+
+.home-hero h1 {
+  font-size: clamp(2.55rem, 7vw, 4.5rem);
+  line-height: 1.13;
+  letter-spacing: -0.055em;
+}
+
+.page-title,
+.post-intro h1 {
+  font-size: clamp(2.05rem, 5vw, 3rem);
+}
+
+.hero-description,
+.page-intro > p {
+  max-width: 36rem;
+  margin-top: 1rem;
+  color: var(--muted);
+}
+
+.home-sections {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 1rem;
+  margin-bottom: 3.25rem;
+}
+
+.feature-card {
+  display: flex;
+  flex-direction: column;
+  padding: clamp(1.15rem, 3vw, 1.65rem);
+  border: 1px solid var(--line);
+  border-radius: 0.85rem;
+  background: var(--surface);
+  color: var(--text);
+  text-decoration: none;
+}
+
+.feature-card:hover {
+  border-color: var(--accent);
+}
+
+.feature-card h2,
+.section-heading h2 {
+  font-size: 1.42rem;
+}
+
+.feature-card p {
+  flex: 1;
+  margin: 0.5rem 0 1.1rem;
+  color: var(--muted);
+}
+
+.card-link,
+.section-heading > a {
+  color: var(--accent);
+  font-size: 0.9rem;
+  font-weight: 700;
+}
+
+.section-heading {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: space-between;
+  align-items: baseline;
+  gap: 0.4rem 1rem;
+  margin-bottom: 0.85rem;
+}
+
+.empty-state {
+  padding: 1.1rem 1.4rem;
+  border: 1px dashed var(--line);
+  border-radius: 0.85rem;
+  color: var(--muted);
+  background: var(--surface);
+}
+
+.review-list,
+.paper-archive {
+  margin: 0;
+  padding: 0;
+  border-top: 1px solid var(--line);
+  list-style: none;
+}
+
+.review-list li,
+.paper-archive li {
+  border-bottom: 1px solid var(--line);
+}
+
+.review-list a,
+.paper-archive a {
+  display: grid;
+  grid-template-columns: 1fr auto;
+  align-items: center;
+  gap: 0.3rem 1.25rem;
+  padding: 1rem 0.25rem;
+  color: var(--text);
+  text-decoration: none;
+}
+
+.review-list a:hover strong,
+.paper-archive a:hover h2 {
+  color: var(--accent);
+  text-decoration: underline;
+}
+
+.review-list time {
+  grid-column: 1 / -1;
+}
+
+.review-list time,
+.paper-archive time,
+.post-intro time,
+.resume-entry span,
+.resume-entry time,
+.section-placeholder {
+  color: var(--muted);
+  font-size: 0.9rem;
+}
+
+.paper-archive h2 {
+  margin-block: 0.2rem;
+  font-size: 1.25rem;
+}
+
+.paper-archive p {
+  color: var(--muted);
+}
+
+.contact-card {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.4rem 1rem;
+  padding: 1rem 1.25rem;
+  border: 1px solid var(--line);
+  border-radius: 0.75rem;
+  background: var(--surface);
+}
+
+.contact-card span {
+  color: var(--muted);
+}
+
+.site-content > h2,
+.post-body h2 {
+  margin-block: 2rem 0.8rem;
+  padding-bottom: 0.45rem;
+  border-bottom: 1px solid var(--line);
+  font-size: 1.35rem;
+}
+
+.resume-entry {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem 1rem;
+  justify-content: space-between;
+  margin-top: 0.75rem;
+}
+
+.resume-entry span {
+  display: block;
+}
+
+.post-intro h1 {
+  margin-block: 0.55rem 0.35rem;
+}
+
+.post-body {
+  max-width: 72ch;
+}
+
+.post-body > * + * {
+  margin-top: 1rem;
+}
+
+.post-body img {
+  max-width: 100%;
+  height: auto;
+}
+
+.post-body pre,
+.post-body table {
+  display: block;
+  max-width: 100%;
+  overflow-x: auto;
+}
+
+.post-body pre,
+.post-body :not(pre) > code {
+  padding: 0.15em 0.4em;
+  border-radius: 0.3rem;
+  background: var(--accent-surface);
+}
+
+.post-body pre {
+  padding: 1rem;
+}
+
+.post-body table {
+  border-collapse: collapse;
+}
+
+.post-body :is(th, td) {
+  border: 1px solid var(--line);
+  padding: 0.4rem 0.7rem;
+  word-break: normal;
+}
+
+.post-body blockquote {
+  margin-inline: 0;
+  padding-left: 1rem;
+  border-left: 3px solid var(--line);
+  color: var(--muted);
+}
+
+@media (max-width: 600px) {
+  .site-header-inner,
+  .site-content,
+  .site-footer {
+    width: calc(100% - 2rem);
+  }
+
+  .site-header-inner {
+    grid-template-columns: 1fr auto;
+  }
+
+  .site-nav {
+    grid-row: 2;
+    grid-column: 1 / -1;
+  }
+
+  .home-sections {
+    grid-template-columns: 1fr;
+  }
+}
