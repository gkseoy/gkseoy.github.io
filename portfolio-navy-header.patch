+main ul.document-list--notion {
+  max-width: 710px;
+  margin: 0.65rem 0 1.25rem;
+  padding: 0;
+  list-style: none;
+  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+}
+
+.document-list--notion > li,
+.document-list--notion > li + li {
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.document-list--notion .document-link {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  box-sizing: border-box;
+  min-height: 32px;
+  padding: 4px 8px;
+  border-radius: 5px;
+  color: #2c2c2c;
+  font-size: 14px;
+  line-height: 20px;
+  text-decoration: none;
+}
+
+.document-list--notion .document-link:hover,
+.document-list--notion .document-link:focus-visible {
+  color: #2c2c2c;
+  background-color: #f0f0ef;
+}
+
+.document-list--notion .notion-document-icon {
+  flex: none;
+  width: 16px;
+  height: 18px;
+  color: #81807c;
+}
+
+.document-list--notion .document-title {
+  min-width: 0;
+  overflow: hidden;
+  font-weight: 600;
+  text-decoration-line: underline;
+  text-decoration-color: #d2d1cd;
+  text-underline-offset: 2px;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.document-list--notion .document-meta {
+  flex: none;
+  margin-inline-start: 6px;
+  color: #37352f;
+  font-size: 12px;
+  white-space: nowrap;
+}
