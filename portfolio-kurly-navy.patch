diff --git a/_includes/home-feed.html b/_includes/home-feed.html
new file mode 100644
index 0000000..8c5746e
--- /dev/null
+++ b/_includes/home-feed.html
@@ -0,0 +1,37 @@
+{% assign feed_entries = '' | split: ',' %}
+{% assign feed_collections = 'paper_reviews,event_notes,seminars' | split: ',' %}
+{% for collection in feed_collections %}
+  {% include section-documents.html collection=collection %}
+  {% assign feed_entries = feed_entries | concat: section_documents %}
+{% endfor %}
+{% assign feed_entries = feed_entries | sort: 'date' | reverse %}
+
+<section class="post-feed" aria-label="Recent posts">
+  {% for entry in feed_entries %}
+    {% assign section_url = entry.collection | replace: '_', '-' | prepend: '/' | append: '/' %}
+    {% assign navigation_item = site.data.navigation | where: 'url', section_url | first %}
+    <article class="feed-post">
+      <a class="feed-link" href="{{ entry.url | relative_url }}" aria-labelledby="feed-post-{{ forloop.index }}">
+        {% if entry.thumbnail %}
+          <span class="feed-thumbnail">
+            <img src="{{ entry.thumbnail | relative_url | escape }}" alt="" width="136" height="136">
+          </span>
+        {% endif %}
+        <div class="feed-text">
+          <h2 id="feed-post-{{ forloop.index }}">{{ entry.title | escape }}</h2>
+          {% if entry.description %}
+            <p{% if entry.lang %} lang="{{ entry.lang | escape }}"{% endif %}>{{ entry.description | escape }}</p>
+          {% endif %}
+          <div class="feed-meta">
+            {% if navigation_item %}<span class="feed-category">{{ navigation_item.title | escape }}</span>{% endif %}
+            <span>{{ entry.author | default: site.author.name | escape }}</span>
+            <span aria-hidden="true">·</span>
+            <time datetime="{{ entry.date | date_to_xmlschema }}">{{ entry.date | date: '%B %-d, %Y' }}</time>
+          </div>
+        </div>
+      </a>
+    </article>
+  {% else %}
+    <p>No posts have been published yet.</p>
+  {% endfor %}
+</section>
diff --git a/_includes/section-tabs.html b/_includes/section-tabs.html
new file mode 100644
index 0000000..20ff1a1
--- /dev/null
+++ b/_includes/section-tabs.html
@@ -0,0 +1,11 @@
+<nav class="section-tabs" aria-label="Blog sections">
+  {% for item in site.data.navigation %}
+    {% unless item.url == '/resume/' %}
+      {% assign section_url_length = item.url | size %}
+      {% assign section_prefix = page.url | slice: 0, section_url_length %}
+      <a href="{{ item.url | relative_url }}"{% if page.url == item.url %} aria-current="page"{% elsif item.url != '/' and section_prefix == item.url %} aria-current="location"{% endif %}>
+        {% if item.url == '/' %}All{% else %}{{ item.title | escape }}{% endif %}
+      </a>
+    {% endunless %}
+  {% endfor %}
+</nav>
diff --git a/_includes/site-frame.css b/_includes/site-frame.css
new file mode 100644
index 0000000..b7a2bc5
--- /dev/null
+++ b/_includes/site-frame.css
@@ -0,0 +1,234 @@
+:root {
+  --portfolio-navy: #101d38;
+  --portfolio-accent: #23457a;
+  --portfolio-tint: #edf2fa;
+  --portfolio-text-muted: #536074;
+  --portfolio-rule: #e1e6ee;
+  --heading-color: var(--portfolio-navy);
+  --link-color-rgb: 35, 69, 122;
+  --link-hover-color: #132b51;
+}
+
+.site-navigation,
+.page-container {
+  max-width: 70rem;
+}
+
+.site-frame {
+  display: flex;
+  flex-direction: column;
+  min-height: 100vh;
+  min-height: 100dvh;
+}
+
+.page-container {
+  display: flex;
+  flex: 1 0 auto;
+  flex-direction: column;
+  width: 100%;
+  min-height: 0;
+  padding-top: clamp(1.25rem, 3vw, 2rem);
+}
+
+.site-header {
+  background-color: #fff;
+}
+
+.site-navigation {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.75rem;
+  min-height: 3.75rem;
+  margin-inline: auto;
+  padding-inline: var(--spacer, 1rem);
+}
+
+@media (min-width: 48rem) {
+  .site-navigation {
+    padding-inline: var(--spacer-2, 2rem);
+  }
+}
+
+.site-brand {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  gap: 0.1rem 0.6rem;
+  color: var(--portfolio-navy);
+  font-size: clamp(1.125rem, 1rem + 0.75vw, 1.5rem);
+  font-weight: 750;
+  line-height: 1.25;
+  letter-spacing: -0.035em;
+}
+
+.site-brand small {
+  color: var(--portfolio-text-muted);
+  font-size: 0.75em;
+  font-weight: 650;
+  letter-spacing: normal;
+}
+
+.site-brand:hover,
+.site-brand:focus-visible {
+  color: var(--portfolio-accent);
+  text-decoration: none;
+}
+
+.site-resume {
+  display: inline-flex;
+  align-items: center;
+  min-height: 2.375rem;
+  padding: 0.375rem 0.875rem;
+  border-radius: 0.5rem;
+  background: var(--portfolio-tint);
+  color: var(--portfolio-navy);
+  font-size: 0.875rem;
+  font-weight: 700;
+}
+
+.site-resume:hover,
+.site-resume:focus-visible,
+.site-resume[aria-current="page"] {
+  background: var(--portfolio-navy);
+  color: #fff;
+  text-decoration: none;
+}
+
+.blog-intro {
+  margin-bottom: clamp(1rem, 3vw, 1.75rem);
+}
+
+.blog-intro h1 {
+  margin: 0 0 0.45rem;
+  font-size: clamp(1.375rem, 1.17rem + 0.85vw, 1.875rem);
+  line-height: 1.3;
+  letter-spacing: -0.028em;
+}
+
+.blog-intro p {
+  margin: 0;
+  color: var(--portfolio-text-muted);
+  font-size: 1rem;
+}
+
+.section-tabs {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0 0.25rem;
+  margin: 0 0 clamp(1.25rem, 3vw, 2rem);
+  border-bottom: 1px solid var(--portfolio-rule);
+}
+
+.section-tabs a {
+  display: flex;
+  align-items: center;
+  min-height: 3rem;
+  padding-inline: clamp(0.6rem, 1.7vw, 1.5rem);
+  color: var(--portfolio-text-muted);
+  font-size: 0.9375rem;
+  font-weight: 650;
+  box-shadow: inset 0 -2px transparent;
+}
+
+.section-tabs a:hover,
+.section-tabs a:focus-visible,
+.section-tabs a[aria-current] {
+  color: var(--portfolio-navy);
+  box-shadow: inset 0 -2px var(--portfolio-navy);
+  text-decoration: none;
+}
+
+.post-feed {
+  display: grid;
+  gap: clamp(0.75rem, 2vw, 1.5rem);
+}
+
+.feed-link {
+  display: flex;
+  align-items: flex-start;
+  gap: clamp(0.875rem, 2vw, 1.5rem);
+  padding: clamp(0.75rem, 1.75vw, 1.5rem);
+  border-radius: 0.75rem;
+  color: inherit;
+}
+
+.feed-link:hover,
+.feed-link:focus-visible {
+  background-color: #f6f8fc;
+  color: inherit;
+  text-decoration: none;
+}
+
+.feed-thumbnail {
+  display: grid;
+  flex: none;
+  place-items: center;
+  width: clamp(5rem, 12vw, 8.5rem);
+  aspect-ratio: 1;
+  overflow: hidden;
+  border-radius: 0.375rem;
+  background: var(--portfolio-tint);
+}
+
+.feed-thumbnail img {
+  width: 100%;
+  height: 100%;
+  margin: 0;
+  padding: 0.4rem;
+  border-radius: 0;
+  object-fit: contain;
+}
+
+.feed-link h2 {
+  margin: 0 0 0.45rem;
+  font-size: clamp(1.125rem, 0.97rem + 0.65vw, 1.5rem);
+  line-height: 1.35;
+  letter-spacing: -0.025em;
+}
+
+.feed-link p {
+  margin: 0 0 0.65rem;
+  color: var(--portfolio-text-muted);
+  font-size: 0.9375rem;
+}
+
+.feed-meta {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 0.25rem 0.45rem;
+  color: var(--portfolio-text-muted);
+  font-size: 0.8125rem;
+}
+
+.feed-category {
+  padding: 0.125rem 0.55rem;
+  border-radius: 100vmax;
+  background-color: var(--portfolio-tint);
+  color: var(--portfolio-accent);
+  font-weight: 650;
+}
+
+.blog-about {
+  margin: clamp(2.25rem, 5vw, 4.5rem) 0 2.5rem;
+  padding-top: 1.5rem;
+  border-top: 1px solid var(--portfolio-rule);
+}
+
+.blog-about h2 {
+  margin-top: 0;
+  font-size: 1.25rem;
+}
+
+.blog-about p {
+  max-width: 70ch;
+  color: var(--portfolio-text-muted);
+  font-size: 0.9375rem;
+}
+
+@media (max-width: 34rem) {
+  .feed-link {
+    padding-inline: 0;
+  }
+}
